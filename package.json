{
  "name": "fibitair-health-workflow",
  "version": "0.1.0",
  "description": "Private Google Health archive with quiet scheduled collection, weekly Gmail packets and read-only MCP.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Yuto Tachibana",
  "repository": {
    "type": "git",
    "url": "https://github.com/JojenJ/fibitair-health-workflow.git"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.local.toml",
    "deploy": "wrangler deploy -c wrangler.workflow.toml",
    "workflow:setup": "tsx scripts/workflow-setup.ts",
    "legacy:setup:google": "tsx scripts/setup-google.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@hono/mcp": "^0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/workers-types": "^4.20260421.1",
    "@types/node": "^22",
    "playwright-core": "^1.64.1",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^2",
    "wrangler": "^4"
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
